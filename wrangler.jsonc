{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gm-webapp-05",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a472f8bc-b405-46b6-826b-79f7afcc49b8","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4986ddccf44b4532a63fae04f39e5be7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
